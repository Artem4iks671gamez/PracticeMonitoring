{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=practice_monitoring_db;Username=<DB_USER>;Password=<DB_PASSWORD>"
  },
  "Jwt": {
    "Key": "<LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>",
    "Issuer": "PracticeMonitoring.Api",
    "Audience": "PracticeMonitoring.Client",
    "ExpiresMinutes": "120"
  },
  "PgTools": {
    "PgDumpPath": "",
    "PgRestorePath": ""
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": false,
    "Username": "<SMTP_USERNAME>",
    "Password": "<SMTP_PASSWORD>",
    "FromEmail": "<FROM_EMAIL>",
    "FromName": "Practice Monitoring"
  },
  "Unisender": {
    "ApiKey": "<UNISENDER_API_KEY>",
    "BaseUrl": "https://api.unisender.com/ru/api",
    "FromEmail": "<VERIFIED_SENDER_EMAIL>",
    "FromName": "Practice Monitoring",
    "ListId": "",
    "ListTitle": "Practice Monitoring"
  },
  "DemoData": {
    "Seed": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
