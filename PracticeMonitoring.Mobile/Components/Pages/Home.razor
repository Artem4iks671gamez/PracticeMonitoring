    {
        var result = await Api.DeleteAppendixAsync(appendixId);
        SetStatus(result.Success ? "Приложение удалено." : result.ErrorMessage, !result.Success);
        if (result.Success && _selectedPractice is not null)
            await OpenPracticeAsync(_selectedPractice.AssignmentId);
    }

