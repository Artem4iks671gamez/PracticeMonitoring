    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _status = string.Empty;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            SetStatus($"Ошибка: {ex.Message}", true);
        }
        finally
        {
            _busy = false;
        }
    }

