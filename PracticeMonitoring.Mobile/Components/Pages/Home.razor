@page "/"
@using System.Text.Json
@using System.Text.Json.Serialization
@inject AppSession Session
@inject PracticeMonitoringApiClient Api
@implements IDisposable

<div class="app-shell @(Session.User?.Theme == "dark" ? "theme-dark" : "")">
    @if (!_ready)
    {
        <div class="loading-screen">
            <div class="brand-mark">PM</div>
            <strong>PracticeMonitoring</strong>
            <span>Подключение к API...</span>
        </div>
    }
    else if (!Session.IsAuthenticated)
    {
        <section class="auth-screen">
            <div class="auth-brand">
                <div class="brand-mark">PM</div>
                <div>
                    <span>PracticeMonitoring</span>
                    <strong>Кабинет студента</strong>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <div class="alert @(_statusIsError ? "alert-error" : "alert-success")">@_status</div>
            }

            <nav class="auth-tabs" aria-label="Авторизация">
                <button type="button" class="@AuthTabClass("login")" @onclick='() => SetAuthMode("login")'>Вход</button>
                <button type="button" class="@AuthTabClass("register")" @onclick='() => SetAuthMode("register")'>Регистрация</button>
                <button type="button" class="@AuthTabClass("forgot")" @onclick='() => SetAuthMode("forgot")'>Забыли пароль?</button>
            </nav>

            @if (_authMode == "login")
            {
                <EditForm Model="_login" OnValidSubmit="LoginAsync" class="form-card">
                    <DataAnnotationsValidator />
                    <label>Email</label>
                    <InputText @bind-Value="_login.Email" inputmode="email" autocomplete="username" />
                    <ValidationMessage For="() => _login.Email" />
                    <label>Пароль</label>
                    <InputText @bind-Value="_login.Password" type="password" autocomplete="current-password" />
                    <ValidationMessage For="() => _login.Password" />
                    <button class="primary-button" disabled="@_busy">Войти</button>
                    <div class="auth-footer">
                        <span>Нет аккаунта?</span>
                        <button type="button" class="link-button" @onclick='() => SetAuthMode("register")'>Зарегистрироваться</button>
                    </div>
                </EditForm>
            }
            else if (_authMode == "register")
            {
                <EditForm Model="_register" OnValidSubmit="RegisterStepAsync" class="form-card">
                    <DataAnnotationsValidator />
                    <h1 class="auth-title">Регистрация</h1>
                    <p class="auth-subtitle">Создайте новую учетную запись</p>
                    <div class="grid-2">
                        <div>
                            <label>Фамилия</label>
                            <InputText @bind-Value="_register.Surname" />
                            <ValidationMessage For="() => _register.Surname" />
                        </div>
                        <div>
                            <label>Имя</label>
                            <InputText @bind-Value="_register.Name" />
                            <ValidationMessage For="() => _register.Name" />
                        </div>
                    </div>
                    <label>Отчество</label>
                    <InputText @bind-Value="_register.Patronymic" />
                    <label>Email</label>
                    <InputText @bind-Value="_register.Email" inputmode="email" autocomplete="username" />
                    <ValidationMessage For="() => _register.Email" />
                    <label>Пароль</label>
                    <InputText @bind-Value="_register.Password" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => _register.Password" />
                    <label>Подтвердите пароль</label>
                    <InputText @bind-Value="_register.ConfirmPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => _register.ConfirmPassword" />
                    <label>Специальность</label>
                    <InputSelect TValue="int?" Value="_register.SpecialtyId" ValueChanged="OnSpecialtyChangedAsync" ValueExpression="() => _register.SpecialtyId">
                        <option value="">Выберите специальность</option>
                        @foreach (var specialty in _specialties)
                        {
                            <option value="@specialty.Id">@specialty.Code @specialty.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _register.SpecialtyId" />
                    <label>Группа</label>
                    <InputSelect @bind-Value="_register.GroupId">
                        <option value="">Выберите группу</option>
                        @foreach (var group in _groups)
                        {
                            <option value="@group.Id">@group.Name, @group.Course курс</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _register.GroupId" />

                    @if (_registrationCodeSent)
                    {
                        <label>Код из письма</label>
                        <InputText @bind-Value="_register.Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                        <ValidationMessage For="() => _register.Code" />
                    }

                    <button class="primary-button" disabled="@_busy">@(_registrationCodeSent ? "Завершить регистрацию" : "Получить код")</button>
                    <div class="auth-footer">
                        <span>Уже есть аккаунт?</span>
                        <button type="button" class="link-button" @onclick='() => SetAuthMode("login")'>Вернуться ко входу</button>
                    </div>
                </EditForm>
            }
            else if (_authMode == "forgot")
            {
                <EditForm Model="_forgot" OnValidSubmit="ForgotPasswordAsync" class="form-card">
                    <DataAnnotationsValidator />
                    <p class="auth-subtitle">Введите email аккаунта</p>
                    <label>Email</label>
                    <InputText @bind-Value="_forgot.Email" inputmode="email" autocomplete="username" />
                    <ValidationMessage For="() => _forgot.Email" />

                    <button class="primary-button" disabled="@_busy">Отправить код</button>
                    <div class="auth-footer">
                        <button type="button" class="link-button" @onclick='() => SetAuthMode("login")'>Вернуться ко входу</button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="_reset" OnValidSubmit="ResetPasswordAsync" class="form-card">
                    <DataAnnotationsValidator />
                    <h1 class="auth-title">Новый пароль</h1>
                    <p class="auth-subtitle">Введите код из письма и новый пароль</p>
                    <label>Email</label>
                    <InputText @bind-Value="_reset.Email" inputmode="email" autocomplete="username" />
                    <ValidationMessage For="() => _reset.Email" />
                    <label>Код из письма</label>
                    <InputText @bind-Value="_reset.Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" />
                    <ValidationMessage For="() => _reset.Code" />
                    <label>Новый пароль</label>
                    <InputText @bind-Value="_reset.NewPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => _reset.NewPassword" />
                    <label>Подтвердите пароль</label>
                    <InputText @bind-Value="_reset.ConfirmPassword" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => _reset.ConfirmPassword" />

                    <button class="primary-button" disabled="@_busy">Сменить пароль</button>
                    <div class="auth-footer">
                        <button type="button" class="link-button" @onclick='() => SetAuthMode("forgot")'>Отправить код заново</button>
                    </div>
                </EditForm>
            }
        </section>
    }
    else
    {
        <main class="student-app">
            <header class="student-header">
                <div class="student-identity">
                    <div class="avatar">@Initials</div>
                    <div>
                        <span>@(Session.User?.GroupName is null ? "Студент" : $"Студент группы {Session.User.GroupName}")</span>
                        <h1>@Session.User?.FullName</h1>
                        <p>@($"{Session.User?.SpecialtyCode} {Session.User?.SpecialtyName}".Trim())</p>
                    </div>
                </div>
                <button class="icon-button" @onclick="RefreshAllAsync">↻</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <div class="alert @(_statusIsError ? "alert-error" : "alert-success")">@_status</div>
            }

            <nav class="bottom-tabs">
                <button class="@MainTabClass("practices")" @onclick='() => _mainTab = "practices"'>Практики</button>
                <button class="@MainTabClass("chats")" @onclick='() => _mainTab = "chats"'>Чаты @UnreadChatBadge</button>
                <button class="@MainTabClass("notifications")" @onclick='() => _mainTab = "notifications"'>Уведомления @UnreadNotificationBadge</button>
                <button class="@MainTabClass("profile")" @onclick='() => _mainTab = "profile"'>Профиль</button>
            </nav>

            @if (_mainTab == "practices")
            {
                <section class="content-stack">
                    <div class="toolbar">
                        <input placeholder="Поиск практики" @bind="_practiceSearch" @bind:event="oninput" />
                        <select @bind="_practiceFilter">
                            <option value="active">Активные</option>
                            <option value="completed">Завершенные</option>
                            <option value="all">Все</option>
                        </select>
                    </div>

                    @foreach (var practice in FilteredPractices)
                    {
                        <article class="practice-card" @onclick="() => OpenPracticeAsync(practice.AssignmentId)">
                            <div>
                                <span class="chip">@practice.PracticeIndex</span>
                                <span class="chip @(practice.IsCompleted ? "muted" : "active")">@(practice.IsCompleted ? "Завершена" : "Активна")</span>
                                @if (practice.IsDetailsOverdue)
                                {
                                    <span class="chip warn">Просрочены сведения</span>
                                }
                            </div>
                            <h2>@practice.Name</h2>
                            <p>@practice.ProfessionalModuleCode @practice.ProfessionalModuleName</p>
                            <div class="card-meta">
                                <span>@DateRange(practice.StartDate, practice.EndDate)</span>
                                <span>Дневник: @practice.DiaryEntriesCount/@practice.WorkDaysCount</span>
                            </div>
                        </article>
                    }

                    @if (!FilteredPractices.Any())
                    {
                        <div class="empty-state">Назначенные практики не найдены.</div>
                    }
                </section>
            }
            else if (_mainTab == "chats")
            {
                <section class="content-stack">
                    <div class="toolbar">
                        <input placeholder="Поиск руководителя" @bind="_contactSearch" @bind:event="oninput" />
                        <button class="secondary-button" @onclick="SearchContactsAsync">Найти</button>
                    </div>
                    @foreach (var contact in _contacts)
                    {
                        <article class="list-card" @onclick="() => StartChatAsync(contact)">
                            <strong>@contact.FullName</strong>
                            <span>@contact.Subtitle</span>
                        </article>
                    }
                    @foreach (var thread in _chatThreads)
                    {
                        <article class="list-card" @onclick="() => OpenThreadAsync(thread.Id)">
                            <strong>@thread.OtherUser.FullName</strong>
                            <span>@thread.LastMessagePreview</span>
                            @if (thread.UnreadCount > 0)
                            {
                                <em>@thread.UnreadCount</em>
                            }
                        </article>
                    }
                </section>
            }
            else if (_mainTab == "notifications")
            {
                <section class="content-stack">
                    <button class="secondary-button" @onclick="MarkAllNotificationsReadAsync">Отметить все прочитанными</button>
                    @foreach (var notification in _notifications)
                    {
                        <article class="list-card @(notification.IsRead ? "" : "unread")" @onclick="() => MarkNotificationReadAsync(notification.Id)">
                            <strong>@notification.Title</strong>
                            <span>@notification.Message</span>
                            <small>@notification.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                        </article>
                    }
                </section>
            }
            else
            {
                <EditForm Model="_profile" OnValidSubmit="SaveProfileAsync" class="content-stack">
                    <div class="form-card">
                        <label>Фамилия</label>
                        <InputText @bind-Value="_profile.Surname" />
                        <label>Имя</label>
                        <InputText @bind-Value="_profile.FirstName" />
                        <label>Отчество</label>
                        <InputText @bind-Value="_profile.Patronymic" />
                        <label>Email</label>
                        <InputText @bind-Value="_profile.Email" inputmode="email" />
                        <label>Тема</label>
                        <InputSelect @bind-Value="_profile.Theme">
                            <option value="light">Светлая</option>
                            <option value="dark">Темная</option>
                        </InputSelect>
                        <button class="primary-button" disabled="@_busy">Сохранить профиль</button>
                    </div>
                    <div class="form-card">
                        <label>Текущий пароль</label>
                        <InputText @bind-Value="_changePassword.CurrentPassword" type="password" />
                        <label>Новый пароль</label>
                        <InputText @bind-Value="_changePassword.NewPassword" type="password" autocomplete="new-password" />
                        <label>Подтвердите пароль</label>
                        <InputText @bind-Value="_changePassword.ConfirmPassword" type="password" autocomplete="new-password" />
                        <button type="button" class="secondary-button" disabled="@_busy" @onclick="ChangePasswordAsync">Сменить пароль</button>
                    </div>
                    <button type="button" class="danger-button" @onclick="LogoutAsync">Выйти</button>
                </EditForm>
            }
        </main>
    }

    @if (_selectedPractice is not null)
    {
        <div class="modal-backdrop">
            <section class="practice-modal">
                <header class="modal-header">
                    <div>
                        <span>@_selectedPractice.PracticeIndex</span>
                        <h2>@_selectedPractice.Name</h2>
                        <p>@DateRange(_selectedPractice.StartDate, _selectedPractice.EndDate)</p>
                    </div>
                    <button class="icon-button light" @onclick="ClosePractice">×</button>
                </header>

                <div class="modal-tabs">
                    @foreach (var tab in _practiceTabs)
                    {
                        <button class="@PracticeTabClass(tab.Key)" @onclick="() => _practiceTab = tab.Key">@tab.Value</button>
                    }
                </div>

                <div class="modal-body">
                    @if (_practiceTab == "overview")
                    {
                        <div class="content-stack">
                            <InfoRow Label="Руководитель" Value="@(_selectedPractice.SupervisorFullName ?? "Не назначен")" />
                            <InfoRow Label="Организация" Value="@(_selectedPractice.OrganizationFullName ?? "Не указана")" />
                            <InfoRow Label="Часы" Value="@($"{_selectedPractice.Hours}")" />
                            <h3>Компетенции</h3>
                            @foreach (var competency in _selectedPractice.Competencies)
                            {
                                <div class="list-card">
                                    <strong>@competency.CompetencyCode</strong>
                                    <span>@competency.CompetencyDescription</span>
                                    <small>@competency.WorkTypes</small>
                                </div>
                            }
                        </div>
                    }
                    else if (_practiceTab == "organization")
                    {
                        <section class="content-stack">
                            <div class="section-head">
                                <div>
                                    <h3>Организация</h3>
                                    <span>@(_organizationEditMode ? "Редактирование" : "Сохраненные сведения")</span>
                                </div>
                                @if (!_organizationEditMode)
                                {
                                    <button type="button" class="secondary-button" @onclick="StartOrganizationEdit">Редактировать</button>
                                }
                            </div>

                            @if (!_organizationEditMode)
                            {
                                <div class="readonly-grid">
                                    <InfoRow Label="Полное название" Value="@DisplayValue(_selectedPractice.OrganizationFullName ?? _selectedPractice.OrganizationName)" />
                                    <InfoRow Label="Сокращенное название" Value="@DisplayValue(_selectedPractice.OrganizationShortName)" />
                                    <InfoRow Label="Адрес" Value="@DisplayValue(_selectedPractice.OrganizationAddress)" />
                                    <InfoRow Label="Руководитель" Value="@DisplayValue(_selectedPractice.OrganizationSupervisorFullName)" />
                                    <InfoRow Label="Должность" Value="@DisplayValue(_selectedPractice.OrganizationSupervisorPosition)" />
                                    <InfoRow Label="Телефон" Value="@DisplayValue(_selectedPractice.OrganizationSupervisorPhone)" />
                                    <InfoRow Label="Email" Value="@DisplayValue(_selectedPractice.OrganizationSupervisorEmail)" />
                                    <InfoRow Label="Содержание задания" Value="@DisplayValue(_selectedPractice.PracticeTaskContent)" />
                                </div>
                            }
                            else
                            {
                                <EditForm Model="_organization" OnValidSubmit="SaveOrganizationAsync" class="form-card">
                                    <label>Полное название организации</label>
                                    <InputText @bind-Value="_organization.OrganizationFullName" />
                                    <label>Сокращенное название</label>
                                    <InputText @bind-Value="_organization.OrganizationShortName" />
                                    <label>Адрес</label>
                                    <InputText @bind-Value="_organization.OrganizationAddress" />
                                    <label>ФИО руководителя</label>
                                    <InputText @bind-Value="_organization.OrganizationSupervisorFullName" />
                                    <label>Должность</label>
                                    <InputText @bind-Value="_organization.OrganizationSupervisorPosition" />
                                    <label>Телефон</label>
                                    <InputText @bind-Value="_organization.OrganizationSupervisorPhone" inputmode="tel" />
                                    <label>Email руководителя</label>
                                    <InputText @bind-Value="_organization.OrganizationSupervisorEmail" inputmode="email" />
                                    <label>Содержание задания</label>
                                    <InputTextArea @bind-Value="_organization.PracticeTaskContent" />
                                    <div class="form-actions">
                                        <button class="primary-button" disabled="@_busy">Сохранить</button>
                                        @if (_selectedPractice.HasRequiredDetails)
                                        {
                                            <button type="button" class="secondary-button" @onclick="CancelOrganizationEdit">Отмена</button>
                                        }
                                    </div>
                                </EditForm>
                            }
                        </section>
                    }
                    else if (_practiceTab == "diary")
                    {
                        <section class="content-stack">
                            <div class="toolbar">
                                <input type="date" value="@_diaryDateText" @onchange="OnDiaryDateChanged" />
                                <button class="secondary-button" @onclick="LoadDiaryDate">Открыть</button>
                            </div>
                            <EditForm Model="_diary" OnValidSubmit="SaveDiaryAsync" class="form-card">
                                <label>Краткое описание</label>
                                <InputTextArea @bind-Value="_diary.ShortDescription" />
                                <label>Подробный отчет за день</label>
                                <div class="day-report-card">
                                    <div class="day-report-summary">
                                        <strong>@ReportStatsText</strong>
                                        <span>@ReportExcerpt</span>
                                    </div>
                                    <div class="report-toolbar">
                                        <button type="button" class="secondary-button" @onclick="AddReportTextBlock">+ Текст</button>
                                        <button type="button" class="secondary-button" @onclick="AddReportTableBlock">+ Таблица</button>
                                        <button type="button" class="secondary-button" @onclick="AddReportImageBlock">+ Рисунок</button>
                                    </div>

                                    @if (_reportBlocks.Count == 0)
                                    {
                                        <div class="empty-state">Добавьте текст, таблицу или рисунок для подробного отчета.</div>
                                    }

                                    @for (var index = 0; index < _reportBlocks.Count; index++)
                                    {
                                        var block = _reportBlocks[index];
                                        <section class="report-block" @key="block.Id">
                                            <div class="report-block-head">
                                                <strong>@ReportBlockTitle(block, index)</strong>
                                                <div>
                                                    <button type="button" class="icon-button tiny" disabled="@(index == 0)" @onclick="() => MoveReportBlock(block, -1)">↑</button>
                                                    <button type="button" class="icon-button tiny" disabled="@(index == _reportBlocks.Count - 1)" @onclick="() => MoveReportBlock(block, 1)">↓</button>
                                                    <button type="button" class="icon-button tiny danger" @onclick="() => RemoveReportBlock(block)">×</button>
                                                </div>
                                            </div>

                                            @if (block.Type == "text")
                                            {
                                                <select @bind="block.Mode">
                                                    <option value="paragraph">Обычный текст</option>
                                                    <option value="bullet_list">Маркированный список</option>
                                                    <option value="numbered_list">Нумерованный список</option>
                                                </select>
                                                <textarea rows="6" placeholder="Опишите выполненную работу, решения, проблемы и результат дня" @bind="block.Content"></textarea>
                                            }
                                            else if (block.Type == "table")
                                            {
                                                <input placeholder="Название таблицы" @bind="block.Title" />
                                                <label class="inline-check">
                                                    <input type="checkbox" @bind="block.HasHeaderRow" />
                                                    первая строка является заголовком
                                                </label>
                                                <div class="report-table-wrap">
                                                    <table class="report-table-editor">
                                                        <tbody>
                                                            @foreach (var row in block.Rows)
                                                            {
                                                                <tr @key="row.Id">
                                                                    @foreach (var cell in row.Cells)
                                                                    {
                                                                        <td @key="cell.Id">
                                                                            <textarea rows="2" @bind="cell.Text"></textarea>
                                                                        </td>
                                                                    }
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                <div class="report-mini-actions">
                                                    <button type="button" class="secondary-button" @onclick="() => AddReportTableRow(block)">+ Строка</button>
                                                    <button type="button" class="secondary-button" @onclick="() => AddReportTableColumn(block)">+ Столбец</button>
                                                    <button type="button" class="secondary-button" disabled="@(block.Rows.Count <= 1)" @onclick="() => RemoveReportTableRow(block)">− Строка</button>
                                                    <button type="button" class="secondary-button" disabled="@(!CanRemoveReportTableColumn(block))" @onclick="() => RemoveReportTableColumn(block)">− Столбец</button>
                                                </div>
                                            }
                                            else if (block.Type == "image")
                                            {
                                                <input placeholder="Название рисунка" @bind="block.Title" />
                                                <input placeholder="Описание изображения" @bind="block.Alt" />
                                                @if (!string.IsNullOrWhiteSpace(block.PreviewUrl))
                                                {
                                                    <img class="report-image-preview" src="@block.PreviewUrl" alt="@block.Alt" />
                                                }
                                                else if (block.AttachmentId.HasValue)
                                                {
                                                    <div class="report-file-pill">Прикреплено: @DisplayValue(block.FileName)</div>
                                                }
                                                else
                                                {
                                                    <div class="empty-state">Изображение не выбрано.</div>
                                                }
                                                <InputFile OnChange="args => OnReportImageSelected(block, args)" accept="image/png,image/jpeg,image/webp" />
                                            }
                                        </section>
                                    }
                                </div>
                                <button class="primary-button" disabled="@_busy">Сохранить день</button>
                            </EditForm>
                            @foreach (var entry in _selectedPractice.DiaryEntries.OrderByDescending(x => x.WorkDate))
                            {
                                <article class="list-card" @onclick="() => SelectDiaryEntry(entry)">
                                    <strong>@entry.WorkDate.ToString("dd.MM.yyyy")</strong>
                                    <span>@entry.ShortDescription</span>
                                    @if (entry.IsReviewed)
                                    {
                                        <small>Проверено: @entry.SupervisorGrade</small>
                                    }
                                </article>
                            }
                        </section>
                    }
                    else if (_practiceTab == "intro")
                    {
                        <section class="content-stack">
                            <div class="section-head">
                                <div>
                                    <h3>Введение</h3>
                                    <span>@(_introEditMode ? "Редактирование" : "Сохраненные сведения")</span>
                                </div>
                                @if (!_introEditMode)
                                {
                                    <button type="button" class="secondary-button" @onclick="StartIntroEdit">Редактировать</button>
                                }
                            </div>

                            @if (!_introEditMode)
                            {
                                <div class="readonly-grid">
                                    <InfoRow Label="Основная цель" Value="@DisplayValue(_selectedPractice.IntroductionMainGoal)" />
                                    <InfoRow Label="Выполняемые обязанности" Value="@DisplayValue(_selectedPractice.StudentDuties)" />
                                    <InfoRow Label="Предоставленные материалы" Value="@DisplayValue(_selectedPractice.ProvidedMaterialsDescription)" />
                                    <InfoRow Label="График работы" Value="@DisplayValue(_selectedPractice.WorkScheduleDescription)" />
                                </div>
                            }
                            else
                            {
                                <EditForm Model="_organization" OnValidSubmit="SaveOrganizationAsync" class="form-card">
                                    <label>Основная цель</label>
                                    <InputTextArea @bind-Value="_organization.IntroductionMainGoal" />
                                    <label>Выполняемые обязанности</label>
                                    <InputTextArea @bind-Value="_organization.StudentDuties" />
                                    <label>Предоставленные материалы</label>
                                    <InputTextArea @bind-Value="_organization.ProvidedMaterialsDescription" />
                                    <label>График работы</label>
                                    <InputTextArea @bind-Value="_organization.WorkScheduleDescription" />
                                    <div class="form-actions">
                                        <button class="primary-button" disabled="@_busy">Сохранить введение</button>
                                        @if (HasIntroductionContent(_selectedPractice))
                                        {
                                            <button type="button" class="secondary-button" @onclick="CancelIntroEdit">Отмена</button>
                                        }
                                    </div>
                                </EditForm>
                            }
                        </section>
                    }
                    else if (_practiceTab == "technical")
                    {
                        <section class="content-stack">
                            <div class="section-head">
                                <div>
                                    <h3>Таблицы</h3>
                                    <span>@(_technicalEditMode ? "Редактирование" : "Сохраненные сведения")</span>
                                </div>
                                @if (!_technicalEditMode)
                                {
                                    <button type="button" class="secondary-button" @onclick="StartTechnicalEdit">Редактировать</button>
                                }
                            </div>

                            @if (!_technicalEditMode)
                            {
                                @if (_selectedPractice.ReportItems.Any(IsTechnicalReportItem))
                                {
                                    @foreach (var item in _selectedPractice.ReportItems.Where(IsTechnicalReportItem).OrderBy(x => x.SortOrder))
                                    {
                                        <article class="list-card">
                                            <strong>@ReportItemCategoryLabel(item.Category): @DisplayValue(item.Name)</strong>
                                            <span>@DisplayValue(item.Description)</span>
