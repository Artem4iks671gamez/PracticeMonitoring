    private void StartOrganizationEdit() => _organizationEditMode = true;
    private void StartIntroEdit() => _introEditMode = true;
    private void StartTechnicalEdit() => _technicalEditMode = true;
    private void StartSourcesEdit() => _sourcesEditMode = true;

    private void CancelOrganizationEdit()
