    private bool _introEditMode;
    private bool _technicalEditMode;
    private bool _sourcesEditMode;
    private bool _registrationCodeSent;
    private string _diaryDateText = DateTime.Today.ToString("yyyy-MM-dd");
    private string _contactSearch = string.Empty;
    private string _chatText = string.Empty;
    private string _appendixTitle = string.Empty;
    private string? _appendixDescription;
    private IBrowserFile? _appendixFile;
    private IBrowserFile? _chatFile;
    private ChatUser? _pendingChatTarget;

    private readonly LoginRequest _login = new();
    private readonly RegisterRequest _register = new();
    private readonly ForgotPasswordRequest _forgot = new();
    private readonly PasswordResetRequest _reset = new();
    private readonly ChangePasswordRequest _changePassword = new();
    private UpdateProfileRequest _profile = new();
    private StudentPracticeOrganizationRequest _organization = new();
    private StudentPracticeDiaryEntryRequest _diary = new();
    private List<StudentPracticeReportItemRequest> _reportItems = new();
    private List<StudentPracticeSourceRequest> _sources = new();
    private List<DayReportBlockModel> _reportBlocks = new();
    private List<StudentPracticeListItem> _practices = new();
    private List<SpecialtyItem> _specialties = new();
    private List<GroupItem> _groups = new();
    private List<NotificationItem> _notifications = new();
    private List<ChatThreadItem> _chatThreads = new();
    private List<ChatUser> _contacts = new();
    private StudentPracticeDetails? _selectedPractice;
    private ChatThreadDetails? _thread;

    private readonly Dictionary<string, string> _practiceTabs = new()
    {
        ["overview"] = "Сведения",
        ["organization"] = "Организация",
        ["diary"] = "Дневник",
        ["intro"] = "Введение",
        ["technical"] = "Таблицы",
        ["sources"] = "Источники",
        ["appendices"] = "Приложения",
        ["documents"] = "Документы"
    };

    private static readonly JsonSerializerOptions DayReportJsonOptions = new(JsonSerializerDefaults.Web)
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    private const long MaxReportImageSizeBytes = 8 * 1024 * 1024;

    private IEnumerable<StudentPracticeListItem> FilteredPractices => _practices
        .Where(x => _practiceFilter == "all" || (_practiceFilter == "active" && !x.IsCompleted) || (_practiceFilter == "completed" && x.IsCompleted))
        .Where(x => string.IsNullOrWhiteSpace(_practiceSearch) ||
            $"{x.PracticeIndex} {x.Name} {x.ProfessionalModuleCode} {x.ProfessionalModuleName} {x.SupervisorFullName} {x.OrganizationName}".Contains(_practiceSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.StartDate);

    private string Initials => string.Join("", new[] { Session.User?.Surname?.FirstOrDefault(), Session.User?.FirstName?.FirstOrDefault() }.Where(x => x.HasValue).Select(x => x!.Value));
    private string UnreadNotificationBadge => _notifications.Count(x => !x.IsRead) > 0 ? $"({_notifications.Count(x => !x.IsRead)})" : string.Empty;
    private string UnreadChatBadge => _chatThreads.Sum(x => x.UnreadCount) > 0 ? $"({_chatThreads.Sum(x => x.UnreadCount)})" : string.Empty;
    private string ReportStatsText => $"{_reportBlocks.Count(x => x.Type == "text")} текст · {_reportBlocks.Count(x => x.Type == "table")} таблиц · {_reportBlocks.Count(x => x.Type == "image")} рисунков";
    private string ReportExcerpt
    {
        get
        {
            var text = string.Join(" · ", _reportBlocks
                .Select(block => block.Type switch
                {
                    "table" => block.Title,
                    "image" => block.Title,
                    _ => block.Content
                })
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value!.Trim()));

            if (string.IsNullOrWhiteSpace(text))
                return "Отчет пока пустой. Добавьте текст, таблицу или рисунок.";

            return text.Length > 160 ? $"{text[..160]}..." : text;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += StateHasChanged;
        try
        {
            await Session.InitializeAsync(Api);
            _specialties = await Api.GetSpecialtiesAsync();
            if (Session.IsAuthenticated)
                await LoadStudentWorkspaceAsync();

            if (_specialties.Count == 0 && !Session.IsAuthenticated)
                SetStatus($"API не ответило. Проверьте, что PracticeMonitoring.Api запущен на {Session.BaseUrl}.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Не удалось подключиться к API: {ex.Message}", true);
        }
        _ready = true;
    }

    private async Task LoginAsync()
    {
        await RunAsync(async () =>
        {
            var result = await Api.LoginAsync(_login);
            if (!result.Success || result.Data is null)
            {
                SetStatus(result.ErrorMessage, true);
                return;
            }

            if (result.Data.Role != "Student")
            {
                SetStatus("Мобильное приложение доступно только студентам.", true);
                return;
            }

            var user = await Api.GetCurrentUserAsync(result.Data.Token);
            if (user is null)
            {
                SetStatus("Не удалось получить профиль.", true);
                return;
            }

            await Session.SignInAsync(result.Data.Token, user);
            SyncProfile();
            await LoadStudentWorkspaceAsync();
            SetStatus(result.Data.MustChangePassword ? "Войдите и смените временный пароль в профиле." : string.Empty, false);
        });
    }

    private async Task RegisterStepAsync()
    {
        await RunAsync(async () =>
        {
            if (!_registrationCodeSent)
            {
                var result = await Api.SendRegistrationCodeAsync(_register);
                _registrationCodeSent = result.Success;
                SetStatus(result.Success ? "Код подтверждения отправлен на email." : result.ErrorMessage, !result.Success);
                return;
            }

            if (string.IsNullOrWhiteSpace(_register.Code))
            {
                SetStatus("Введите код подтверждения.", true);
                return;
            }

            var registerResult = await Api.RegisterAsync(_register);
            if (!registerResult.Success || registerResult.Data is null)
            {
                SetStatus(registerResult.ErrorMessage, true);
                return;
            }

            var user = await Api.GetCurrentUserAsync(registerResult.Data.Token);
            if (user is null)
            {
                SetStatus("Регистрация выполнена, но профиль не загрузился.", true);
                return;
            }

            await Session.SignInAsync(registerResult.Data.Token, user);
            SyncProfile();
            await LoadStudentWorkspaceAsync();
        });
    }

    private async Task ForgotPasswordAsync()
    {
        await RunAsync(async () =>
        {
            var result = await Api.ForgotPasswordAsync(_forgot.Email);
            if (!result.Success)
            {
                SetStatus(result.ErrorMessage, true);
                return;
            }

            _reset.Email = _forgot.Email;
            _reset.Code = string.Empty;
            _reset.NewPassword = string.Empty;
            _reset.ConfirmPassword = string.Empty;
            _authMode = "reset";
            SetStatus("Если аккаунт существует, код отправлен на email.", false);
        });
    }

    private async Task ResetPasswordAsync()
    {
        await RunAsync(async () =>
        {
            var resetResult = await Api.ResetPasswordAsync(_reset);
            SetStatus(resetResult.Success ? "Пароль изменен. Теперь можно войти." : resetResult.ErrorMessage, !resetResult.Success);
            if (resetResult.Success)
            {
                _reset.Code = string.Empty;
                _reset.NewPassword = string.Empty;
                _reset.ConfirmPassword = string.Empty;
                _authMode = "login";
            }
        });
    }

    private async Task OnSpecialtyChangedAsync(int? value)
    {
        _register.SpecialtyId = value;
        _register.GroupId = null;
        _groups = value.HasValue ? await Api.GetGroupsAsync(value.Value) : new List<GroupItem>();
    }

    private async Task LoadStudentWorkspaceAsync()
    {
        SyncProfile();
        _practices = await Api.GetPracticesAsync();
        _notifications = await Api.GetNotificationsAsync();
        _chatThreads = await Api.GetChatThreadsAsync();
    }

    private async Task RefreshAllAsync() => await RunAsync(LoadStudentWorkspaceAsync);

    private async Task OpenPracticeAsync(int assignmentId)
    {
        await RunAsync(async () =>
        {
            _selectedPractice = await Api.GetPracticeAsync(assignmentId);
            if (_selectedPractice is null)
            {
                SetStatus("Не удалось открыть практику.", true);
                return;
            }

            _practiceTab = "overview";
            SyncPracticeForms();
        });
    }

    private void SyncPracticeForms()
    {
        if (_selectedPractice is null)
            return;

        _organization = new StudentPracticeOrganizationRequest
        {
            OrganizationName = _selectedPractice.OrganizationName,
            OrganizationFullName = _selectedPractice.OrganizationFullName,
            OrganizationShortName = _selectedPractice.OrganizationShortName,
            OrganizationAddress = _selectedPractice.OrganizationAddress,
            OrganizationSupervisorFullName = _selectedPractice.OrganizationSupervisorFullName,
            OrganizationSupervisorPosition = _selectedPractice.OrganizationSupervisorPosition,
            OrganizationSupervisorPhone = _selectedPractice.OrganizationSupervisorPhone,
            OrganizationSupervisorEmail = _selectedPractice.OrganizationSupervisorEmail,
            PracticeTaskContent = _selectedPractice.PracticeTaskContent,
            StudentDuties = _selectedPractice.StudentDuties,
            ProvidedMaterialsDescription = _selectedPractice.ProvidedMaterialsDescription,
            WorkScheduleDescription = _selectedPractice.WorkScheduleDescription,
            IntroductionMainGoal = _selectedPractice.IntroductionMainGoal
        };

        _reportItems = _selectedPractice.ReportItems.Select(x => new StudentPracticeReportItemRequest { Category = x.Category, Name = x.Name, Description = x.Description }).ToList();
        _sources = _selectedPractice.Sources.Select(x => new StudentPracticeSourceRequest { Title = x.Title, Url = x.Url, Description = x.Description }).ToList();
        _organizationEditMode = !_selectedPractice.HasRequiredDetails;
        _introEditMode = !HasIntroductionContent(_selectedPractice);
        _technicalEditMode = !_selectedPractice.ReportItems.Any(IsTechnicalReportItem);
        _sourcesEditMode = _selectedPractice.Sources.Count == 0;
        _diaryDateText = _selectedPractice.StartDate.ToString("yyyy-MM-dd");
        LoadDiaryDate();
