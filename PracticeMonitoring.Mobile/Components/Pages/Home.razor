    private async Task SaveProfileAsync()
    {
        await RunAsync(async () =>
        {
            var result = await Api.UpdateProfileAsync(_profile);
            if (result.Success && result.Data is not null)
            {
                Session.SetUser(result.Data);
                SyncProfile();
                SetStatus("Профиль сохранен.", false);
            }
            else
            {
                SetStatus(result.ErrorMessage, true);
            }
        });
    }

    private async Task ChangePasswordAsync()
    {
        await RunAsync(async () =>
        {
            if (string.IsNullOrWhiteSpace(_changePassword.NewPassword))
            {
                SetStatus("Введите новый пароль.", true);
                return;
            }

            if (_changePassword.NewPassword != _changePassword.ConfirmPassword)
            {
                SetStatus("Пароли не совпадают.", true);
                return;
            }

            var result = await Api.ChangePasswordAsync(_changePassword);
            SetStatus(result.Success ? "Пароль изменен." : result.ErrorMessage, !result.Success);
            if (result.Success)
            {
                _changePassword.CurrentPassword = null;
                _changePassword.NewPassword = string.Empty;
                _changePassword.ConfirmPassword = string.Empty;
            }
        });
    }

    private void SyncProfile()
    {
        if (Session.User is null)
            return;

        _profile = new UpdateProfileRequest
        {
            Surname = Session.User.Surname,
            FirstName = Session.User.FirstName,
            Patronymic = Session.User.Patronymic,
            Email = Session.User.Email,
            AvatarUrl = Session.User.AvatarUrl,
            Theme = Session.User.Theme
        };
    }

