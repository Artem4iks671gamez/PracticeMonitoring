    private async Task UploadAppendixAsync()
    {
        if (_selectedPractice is null)
            return;

        var result = await Api.UploadAppendixAsync(_selectedPractice.AssignmentId, _appendixTitle, _appendixDescription, _appendixFile);
        if (result.Success && result.Data is not null)
        {
            _selectedPractice = result.Data.Details;
            SyncPracticeForms();
            _appendixTitle = string.Empty;
            _appendixDescription = null;
            _appendixFile = null;
            SetStatus("Приложение загружено.", false);
        }
        else
        {
            SetStatus(result.ErrorMessage, true);
        }
    }

