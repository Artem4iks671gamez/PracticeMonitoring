    private async Task SendMessageAsync()
    {
        if (_thread is null)
            return;

        var result = await Api.SendChatMessageAsync(_thread.Id, _thread.Id == 0 ? _pendingChatTarget?.Id : null, _chatText, _chatFile);
        if (result.Success && result.Data is not null)
        {
            _chatText = string.Empty;
            _chatFile = null;
            _thread = await Api.GetChatThreadAsync(result.Data.ThreadId);
            _chatThreads = await Api.GetChatThreadsAsync();
            _contacts.Clear();
        }
        else
        {
            SetStatus(result.ErrorMessage, true);
        }
    }

