                            else
                            {
                                <div class="toolbar">
                                    <button type="button" class="secondary-button" @onclick='() => AddReportItem("TechnicalTool")'>+ Техническое средство</button>
                                    <button type="button" class="secondary-button" @onclick='() => AddReportItem("SoftwareTool")'>+ ПО/технология</button>
                                </div>
                                @foreach (var item in _reportItems)
                                {
                                    <div class="form-card compact">
                                        <select @bind="item.Category">
                                            <option value="TechnicalTool">Техническое средство</option>
                                            <option value="SoftwareTool">Программное средство</option>
                                            <option value="IntroductionWorkType">Вид работ</option>
                                            <option value="IntroductionSoftwareTechnology">Технология</option>
                                        </select>
                                        <input placeholder="Название" @bind="item.Name" />
                                        <textarea placeholder="Описание" @bind="item.Description"></textarea>
                                    </div>
                                }
                                <div class="form-actions">
                                    <button type="button" class="primary-button" @onclick="SaveReportItemsAsync">Сохранить таблицы</button>
                                    @if (_selectedPractice.ReportItems.Any(IsTechnicalReportItem))
                                    {
                                        <button type="button" class="secondary-button" @onclick="CancelTechnicalEdit">Отмена</button>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else if (_practiceTab == "sources")
                    {
                        <section class="content-stack">
                            <div class="section-head">
                                <div>
                                    <h3>Источники</h3>
                                    <span>@(_sourcesEditMode ? "Редактирование" : "Сохраненный список")</span>
                                </div>
                                @if (!_sourcesEditMode)
                                {
                                    <button type="button" class="secondary-button" @onclick="StartSourcesEdit">Редактировать</button>
                                }
                            </div>

                            @if (!_sourcesEditMode)
                            {
                                @if (_selectedPractice.Sources.Count > 0)
                                {
                                    @foreach (var source in _selectedPractice.Sources.OrderBy(x => x.SortOrder))
                                    {
                                        <article class="list-card">
                                            <strong>@source.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(source.Url))
                                            {
                                                <span>@source.Url</span>
                                            }
                                            <small>@DisplayValue(source.Description)</small>
                                        </article>
                                    }
                                }
                                else
                                {
                                    <div class="empty-state">Источники пока не указаны.</div>
                                }
                            }
                            else
                            {
                                <button type="button" class="secondary-button" @onclick="AddSource">+ Источник</button>
                                @foreach (var source in _sources)
                                {
                                    <div class="form-card compact">
                                        <input placeholder="Название" @bind="source.Title" />
                                        <input placeholder="URL" @bind="source.Url" />
                                        <textarea placeholder="Описание" @bind="source.Description"></textarea>
                                    </div>
                                }
                                <div class="form-actions">
                                    <button type="button" class="primary-button" @onclick="SaveSourcesAsync">Сохранить источники</button>
                                    @if (_selectedPractice.Sources.Count > 0)
                                    {
                                        <button type="button" class="secondary-button" @onclick="CancelSourcesEdit">Отмена</button>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else if (_practiceTab == "appendices")
                    {
                        <section class="content-stack">
                            <div class="form-card">
                                <label>Название приложения</label>
                                <input @bind="_appendixTitle" />
                                <label>Описание</label>
                                <textarea @bind="_appendixDescription"></textarea>
                                <InputFile OnChange="OnAppendixFileSelected" />
                                <button class="primary-button" @onclick="UploadAppendixAsync">Загрузить</button>
                            </div>
                            @foreach (var appendix in _selectedPractice.Appendices)
                            {
                                <article class="list-card">
                                    <strong>@appendix.Title</strong>
                                    <span>@appendix.FileName</span>
                                    <button class="secondary-button" @onclick="() => DownloadAppendixAsync(appendix.Id)">Открыть</button>
                                    <button class="danger-button" @onclick="() => DeleteAppendixAsync(appendix.Id)">Удалить</button>
                                </article>
                            }
                        </section>
                    }
                    else
                    {
                        <section class="content-stack">
                            <button class="primary-button" @onclick="DownloadPracticeReportAsync">Сформировать отчет практики</button>
                            <button class="secondary-button" disabled>Аттестационный лист</button>
                            <button class="secondary-button" disabled>Дневник практики</button>
                        </section>
                    }
                </div>
            </section>
        </div>
    }

    @if (_thread is not null)
    {
        <div class="modal-backdrop">
            <section class="practice-modal chat-modal">
                <header class="modal-header">
                    <div>
                        <span>@_thread.OtherUser.Subtitle</span>
                        <h2>@_thread.OtherUser.FullName</h2>
                    </div>
                    <button class="icon-button light" @onclick="CloseThread">×</button>
                </header>
                <div class="messages">
                    @foreach (var message in _thread.Messages)
                    {
                        <div class="message @(message.SenderUserId == Session.User?.Id ? "own" : "")">
                            <span>@message.SenderFullName</span>
                            <p>@message.Text</p>
                            @foreach (var file in message.Attachments)
                            {
                                <button class="link-button" @onclick="() => DownloadChatAttachmentAsync(file.Id, file.FileName)">@file.FileName</button>
                            }
                        </div>
                    }
                </div>
                <div class="chat-compose">
                    <textarea placeholder="Сообщение" @bind="_chatText"></textarea>
                    <InputFile OnChange="OnChatFileSelected" />
                    <button class="primary-button" @onclick="SendMessageAsync">Отправить</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private bool _ready;
    private bool _busy;
    private bool _statusIsError;
    private string _status = string.Empty;
    private string _authMode = "login";
    private string _mainTab = "practices";
    private string _practiceTab = "overview";
    private string _practiceSearch = string.Empty;
    private string _practiceFilter = "active";
