            _reportItems = _selectedPractice.ReportItems.Select(x => new StudentPracticeReportItemRequest { Category = x.Category, Name = x.Name, Description = x.Description }).ToList();

        _technicalEditMode = false;
    }

    private void CancelSourcesEdit()
    {
        if (_selectedPractice is not null)
            _sources = _selectedPractice.Sources.Select(x => new StudentPracticeSourceRequest { Title = x.Title, Url = x.Url, Description = x.Description }).ToList();

        _sourcesEditMode = false;
    }

    private void SyncOrganizationForm()
    {
        if (_selectedPractice is null)
            return;

        _organization = new StudentPracticeOrganizationRequest
        {
            OrganizationName = _selectedPractice.OrganizationName,
            OrganizationFullName = _selectedPractice.OrganizationFullName,
            OrganizationShortName = _selectedPractice.OrganizationShortName,
            OrganizationAddress = _selectedPractice.OrganizationAddress,
            OrganizationSupervisorFullName = _selectedPractice.OrganizationSupervisorFullName,
            OrganizationSupervisorPosition = _selectedPractice.OrganizationSupervisorPosition,
            OrganizationSupervisorPhone = _selectedPractice.OrganizationSupervisorPhone,
            OrganizationSupervisorEmail = _selectedPractice.OrganizationSupervisorEmail,
            PracticeTaskContent = _selectedPractice.PracticeTaskContent,
            StudentDuties = _selectedPractice.StudentDuties,
            ProvidedMaterialsDescription = _selectedPractice.ProvidedMaterialsDescription,
            WorkScheduleDescription = _selectedPractice.WorkScheduleDescription,
            IntroductionMainGoal = _selectedPractice.IntroductionMainGoal
        };
    }

    private async Task SaveOrganizationAsync()
    {
        if (_selectedPractice is null)
            return;

        await SavePracticeResultAsync(await Api.SaveOrganizationAsync(_selectedPractice.AssignmentId, _organization), "Сведения сохранены.");
    }

    private void LoadDiaryDate()
    {
        if (_selectedPractice is null || !DateTime.TryParse(_diaryDateText, out var date))
            return;

        var entry = _selectedPractice.DiaryEntries.FirstOrDefault(x => x.WorkDate.Date == date.Date);
        _diary = new StudentPracticeDiaryEntryRequest
        {
            WorkDate = date,
            ShortDescription = entry?.ShortDescription ?? string.Empty,
            DetailedReport = string.IsNullOrWhiteSpace(entry?.DetailedReport) ? "{\"version\":3,\"type\":\"practice-day-report\",\"blocks\":[]}" : entry!.DetailedReport,
            KeptAttachmentIds = entry?.Attachments.Select(x => x.Id).ToList() ?? new List<int>()
        };
        _reportBlocks = ParseDayReport(_diary.DetailedReport, entry?.Attachments ?? new List<StudentPracticeDiaryAttachment>());
    }

    private void OnDiaryDateChanged(ChangeEventArgs args)
    {
        _diaryDateText = args.Value?.ToString() ?? DateTime.Today.ToString("yyyy-MM-dd");
        LoadDiaryDate();
    }

    private void SelectDiaryEntry(StudentPracticeDiaryEntry entry)
    {
        _diaryDateText = entry.WorkDate.ToString("yyyy-MM-dd");
        LoadDiaryDate();
    }

    private async Task SaveDiaryAsync()
    {
        if (_selectedPractice is null)
            return;

        if (DateTime.TryParse(_diaryDateText, out var date))
            _diary.WorkDate = date;

        _diary.DetailedReport = SerializeDayReport();
        _diary.Figures = BuildDiaryFigures();

        await SavePracticeResultAsync(await Api.SaveDiaryEntryAsync(_selectedPractice.AssignmentId, _diary), "День сохранен.");
    }

    private void AddReportTextBlock()
        => _reportBlocks.Add(new DayReportBlockModel { Id = MakeReportId("text"), Type = "text", Mode = "paragraph" });

    private void AddReportTableBlock()
        => _reportBlocks.Add(new DayReportBlockModel
        {
            Id = MakeReportId("table"),
            Type = "table",
            Title = "Результаты работы",
            HasHeaderRow = true,
            Rows =
            {
                new DayReportTableRowModel
                {
                    Id = MakeReportId("row"),
                    Cells =
                    {
                        new DayReportTableCellModel { Id = MakeReportId("cell"), Text = "Показатель" },
                        new DayReportTableCellModel { Id = MakeReportId("cell"), Text = "Описание" }
                    }
                },
                new DayReportTableRowModel
                {
                    Id = MakeReportId("row"),
                    Cells =
                    {
                        new DayReportTableCellModel { Id = MakeReportId("cell") },
                        new DayReportTableCellModel { Id = MakeReportId("cell") }
                    }
                }
            }
        });

    private void AddReportImageBlock()
        => _reportBlocks.Add(new DayReportBlockModel
        {
            Id = MakeReportId("image"),
            Type = "image",
            Title = "Рисунок",
            UploadClientId = MakeReportId("upload")
        });

    private void RemoveReportBlock(DayReportBlockModel block) => _reportBlocks.Remove(block);

    private void MoveReportBlock(DayReportBlockModel block, int direction)
    {
        var index = _reportBlocks.IndexOf(block);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= _reportBlocks.Count)
            return;

        _reportBlocks.RemoveAt(index);
        _reportBlocks.Insert(targetIndex, block);
    }

    private void AddReportTableRow(DayReportBlockModel block)
    {
        var columns = Math.Max(1, block.Rows.FirstOrDefault()?.Cells.Count ?? 2);
        block.Rows.Add(new DayReportTableRowModel
        {
            Id = MakeReportId("row"),
            Cells = Enumerable.Range(0, columns)
                .Select(_ => new DayReportTableCellModel { Id = MakeReportId("cell") })
                .ToList()
        });
    }

    private void AddReportTableColumn(DayReportBlockModel block)
    {
        if (block.Rows.Count == 0)
            block.Rows.Add(new DayReportTableRowModel { Id = MakeReportId("row") });

        foreach (var row in block.Rows)
            row.Cells.Add(new DayReportTableCellModel { Id = MakeReportId("cell") });
    }

    private void RemoveReportTableRow(DayReportBlockModel block)
    {
        if (block.Rows.Count > 1)
            block.Rows.RemoveAt(block.Rows.Count - 1);
    }

    private void RemoveReportTableColumn(DayReportBlockModel block)
    {
        if (!CanRemoveReportTableColumn(block))
            return;

        foreach (var row in block.Rows)
            row.Cells.RemoveAt(row.Cells.Count - 1);
    }

    private static bool CanRemoveReportTableColumn(DayReportBlockModel block)
        => block.Rows.Count > 0 && block.Rows.All(row => row.Cells.Count > 1);

    private async Task OnReportImageSelected(DayReportBlockModel block, InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
            return;

        if (file.Size > MaxReportImageSizeBytes)
        {
            SetStatus("Размер рисунка не должен превышать 8 МБ.", true);
            return;
        }

        var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
        if (!contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            SetStatus("К подробному отчету можно прикреплять только изображения.", true);
            return;
        }

        await using var stream = file.OpenReadStream(MaxReportImageSizeBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var base64 = Convert.ToBase64String(memory.ToArray());

        block.AttachmentId = null;
        block.UploadClientId = string.IsNullOrWhiteSpace(block.UploadClientId) ? MakeReportId("upload") : block.UploadClientId;
        block.FileName = file.Name;
        block.MimeType = contentType;
        block.Base64Content = base64;
        block.PreviewUrl = $"data:{contentType};base64,{base64}";
        if (string.IsNullOrWhiteSpace(block.Title))
            block.Title = Path.GetFileNameWithoutExtension(file.Name);
    }

    private string SerializeDayReport()
    {
        var blocks = _reportBlocks.Select(block =>
        {
            if (block.Type == "table")
            {
                var rows = block.Rows.Count > 0 ? block.Rows : new List<DayReportTableRowModel>
                {
                    new() { Id = MakeReportId("row"), Cells = { new DayReportTableCellModel { Id = MakeReportId("cell") } } }
                };

                return (object)new
                {
                    type = "table",
                    id = block.Id,
                    title = block.Title?.Trim(),
                    hasHeaderRow = block.HasHeaderRow,
                    rows = rows.Select(row => new
                    {
                        id = row.Id,
                        cells = row.Cells.Select(cell => new
                        {
                            id = cell.Id,
                            text = cell.Text?.Trim(),
                            colspan = 1,
                            rowspan = 1,
                            hidden = false
                        })
                    })
                };
            }

            if (block.Type == "image")
            {
                if (!block.AttachmentId.HasValue && string.IsNullOrWhiteSpace(block.UploadClientId))
                    block.UploadClientId = MakeReportId("upload");

                return (object)new
                {
                    type = "image",
                    id = block.Id,
                    title = block.Title?.Trim(),
                    attachmentId = block.AttachmentId,
                    uploadClientId = block.AttachmentId.HasValue ? null : block.UploadClientId,
                    alt = block.Alt?.Trim(),
                    imageUrl = block.ImageUrl
                };
            }

            return new
            {
                type = "text",
                id = block.Id,
                content = block.Content?.Trim(),
                mode = string.IsNullOrWhiteSpace(block.Mode) ? "paragraph" : block.Mode
            };
        }).ToList();

        return JsonSerializer.Serialize(new
        {
            version = 3,
            type = "practice-day-report",
            blocks
        }, DayReportJsonOptions);
    }

    private List<StudentPracticeDiaryFigureRequest> BuildDiaryFigures()
        => _reportBlocks
            .Where(block => block.Type == "image" && !string.IsNullOrWhiteSpace(block.Base64Content))
            .Select((block, index) => new StudentPracticeDiaryFigureRequest
            {
                ClientId = block.UploadClientId,
                Caption = string.IsNullOrWhiteSpace(block.Title) ? "Рисунок" : block.Title.Trim(),
                FileName = string.IsNullOrWhiteSpace(block.FileName) ? "figure.png" : block.FileName,
                ContentType = string.IsNullOrWhiteSpace(block.MimeType) ? "image/png" : block.MimeType,
                Base64Content = block.Base64Content,
                SortOrder = index + 1
            })
            .ToList();

    private static List<DayReportBlockModel> ParseDayReport(string? value, List<StudentPracticeDiaryAttachment> attachments)
    {
        if (string.IsNullOrWhiteSpace(value))
            return new List<DayReportBlockModel> { new() { Id = MakeReportId("text"), Type = "text", Mode = "paragraph" } };

        try
        {
            using var document = JsonDocument.Parse(value);
            var root = document.RootElement;
            JsonElement blocksElement;
            if (!root.TryGetProperty("blocks", out blocksElement) && !root.TryGetProperty("content", out blocksElement))
                return new List<DayReportBlockModel> { new() { Id = MakeReportId("text"), Type = "text", Content = value, Mode = "paragraph" } };

            var blocks = blocksElement.EnumerateArray()
                .Select(block => ParseDayReportBlock(block, attachments))
                .Where(block => block is not null)
                .Select(block => block!)
                .ToList();

            return blocks.Count > 0
                ? blocks
                : new List<DayReportBlockModel> { new() { Id = MakeReportId("text"), Type = "text", Mode = "paragraph" } };
        }
        catch
        {
            return new List<DayReportBlockModel> { new() { Id = MakeReportId("text"), Type = "text", Content = value, Mode = "paragraph" } };
        }
    }

    private static DayReportBlockModel? ParseDayReportBlock(JsonElement element, List<StudentPracticeDiaryAttachment> attachments)
    {
        var type = GetJsonString(element, "type") ?? "text";
        var id = GetJsonString(element, "id") ?? MakeReportId(type);
        if (type is "table")
        {
            var block = new DayReportBlockModel
            {
                Id = id,
                Type = "table",
                Title = GetJsonString(element, "title") ?? GetJsonString(element, "caption"),
                HasHeaderRow = GetJsonBool(element, "hasHeaderRow") || GetJsonBool(element, "hasHeader")
            };

            if (element.TryGetProperty("rows", out var rowsElement) && rowsElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var rowElement in rowsElement.EnumerateArray())
                {
                    var row = new DayReportTableRowModel { Id = GetJsonString(rowElement, "id") ?? MakeReportId("row") };
                    if (rowElement.TryGetProperty("cells", out var cellsElement) && cellsElement.ValueKind == JsonValueKind.Array)
                    {
                        foreach (var cellElement in cellsElement.EnumerateArray())
                        {
                            if (GetJsonBool(cellElement, "hidden"))
                                continue;

                            row.Cells.Add(new DayReportTableCellModel
                            {
                                Id = GetJsonString(cellElement, "id") ?? MakeReportId("cell"),
                                Text = GetJsonString(cellElement, "text")
                            });
                        }
                    }

                    if (row.Cells.Count > 0)
                        block.Rows.Add(row);
                }
            }

            if (block.Rows.Count == 0)
                block.Rows.Add(new DayReportTableRowModel { Id = MakeReportId("row"), Cells = { new DayReportTableCellModel { Id = MakeReportId("cell") } } });

            return block;
        }

        if (type is "image" or "figure")
        {
            var attachmentId = GetJsonInt(element, "attachmentId");
            var attachment = attachmentId.HasValue ? attachments.FirstOrDefault(x => x.Id == attachmentId.Value) : null;
            return new DayReportBlockModel
            {
                Id = id,
                Type = "image",
                Title = GetJsonString(element, "title") ?? GetJsonString(element, "caption") ?? attachment?.Caption,
                AttachmentId = attachmentId,
                UploadClientId = GetJsonString(element, "uploadClientId"),
                ImageUrl = GetJsonString(element, "imageUrl"),
                Alt = GetJsonString(element, "alt"),
                FileName = GetJsonString(element, "fileName") ?? attachment?.FileName,
                MimeType = GetJsonString(element, "mimeType") ?? attachment?.ContentType
            };
        }

        return new DayReportBlockModel
        {
            Id = id,
            Type = "text",
            Content = GetJsonString(element, "content") ?? GetJsonString(element, "text") ?? string.Empty,
            Mode = GetJsonString(element, "mode") ?? "paragraph"
        };
    }

    private static string? GetJsonString(JsonElement element, string property)
        => element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() : null;

    private static bool GetJsonBool(JsonElement element, string property)
        => element.TryGetProperty(property, out var value) &&
           (value.ValueKind == JsonValueKind.True || value.ValueKind == JsonValueKind.False) &&
           value.GetBoolean();

    private static int? GetJsonInt(JsonElement element, string property)
        => element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.Number && value.TryGetInt32(out var number) ? number : null;

    private static string MakeReportId(string prefix) => $"{prefix}-{Guid.NewGuid():N}"[..Math.Min(prefix.Length + 9, prefix.Length + 33)];

