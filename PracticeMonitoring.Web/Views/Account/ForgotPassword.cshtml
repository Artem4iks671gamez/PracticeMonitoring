@model PracticeMonitoring.Web.Models.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="loginwrap">
    <div class="loginblock">
        <h1 class="login-title">Восстановление пароля</h1>
        <p class="login-subtitle">Введите email аккаунта</p>

        @if (ViewBag.Error != null)
        {
            <div class="validation-error">@ViewBag.Error</div>
        }

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="Введите email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="login-button">Отправить код</button>
        </form>

        <div class="login-footer">
            <a asp-action="Login" class="login-link">Вернуться ко входу</a>
        </div>
    </div>
</div>
