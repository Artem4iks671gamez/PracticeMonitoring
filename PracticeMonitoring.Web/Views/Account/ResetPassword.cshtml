@model PracticeMonitoring.Web.Models.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Новый пароль";
}

<div class="loginwrap">
    <div class="loginblock">
        <h1 class="login-title">Новый пароль</h1>
        <p class="login-subtitle">Введите код из письма и новый пароль</p>

        @if (ViewBag.Error != null)
        {
            <div class="validation-error">@ViewBag.Error</div>
        }

        @if (ViewBag.Info != null)
        {
            <div class="student-alert student-alert-success">@ViewBag.Info</div>
        }

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-action="ResetPassword" method="post" class="auth-form" novalidate>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="Введите email" autocomplete="username" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Code" class="form-label">Код из письма</label>
                <input asp-for="Code" class="form-input" placeholder="Введите 6 цифр" inputmode="numeric" autocomplete="one-time-code" />
                <span asp-validation-for="Code" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                <input asp-for="NewPassword" type="password" class="form-input" placeholder="Введите новый пароль" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Подтвердите пароль</label>
                <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Повторите пароль" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="login-button">Сменить пароль</button>
        </form>

        <div class="login-footer">
            <a asp-action="ForgotPassword" class="login-link">Отправить код заново</a>
        </div>
    </div>
</div>
