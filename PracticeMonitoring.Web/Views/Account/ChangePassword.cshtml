@model PracticeMonitoring.Web.Models.Auth.ChangePasswordViewModel

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="loginwrap">
    <div class="loginblock">
        <h1 class="login-title">Смена пароля</h1>
        <p class="login-subtitle">@(Model.MustChangePassword ? "Замените временный пароль перед продолжением" : "Укажите новый пароль")</p>

        @if (ViewBag.Error != null)
        {
            <div class="validation-error">@ViewBag.Error</div>
        }

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-action="ChangePassword" method="post" class="auth-form" novalidate>
            <input asp-for="MustChangePassword" type="hidden" />

            @if (!Model.MustChangePassword)
            {
                <div class="form-group">
                    <label asp-for="CurrentPassword" class="form-label">Текущий пароль</label>
                    <input asp-for="CurrentPassword" type="password" class="form-input" placeholder="Введите текущий пароль" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="field-validation-error"></span>
                </div>
            }

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                <input asp-for="NewPassword" type="password" class="form-input" placeholder="Введите новый пароль" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Подтвердите пароль</label>
                <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="Повторите пароль" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <button type="submit" class="login-button">Сохранить пароль</button>
        </form>
    </div>
</div>
